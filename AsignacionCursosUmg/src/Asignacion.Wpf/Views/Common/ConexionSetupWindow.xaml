<Window x:Class="Asignacion.Wpf.Views.Common.ConexionSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conexión a la base de datos" Height="420" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Configure la conexión a MySQL" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4">
            <TextBlock Text="Host:" Width="90" VerticalAlignment="Center"/>
            <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Width="260"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4">
            <TextBlock Text="Puerto:" Width="90" VerticalAlignment="Center"/>
            <TextBox Text="{Binding Puerto, UpdateSourceTrigger=PropertyChanged}" Width="260"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,4">
            <TextBlock Text="Base de datos:" Width="90" VerticalAlignment="Center"/>
            <TextBox Text="{Binding BaseDatos, UpdateSourceTrigger=PropertyChanged}" Width="260"/>
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,4">
            <TextBlock Text="Usuario:" Width="90" VerticalAlignment="Center"/>
            <TextBox Text="{Binding Usuario, UpdateSourceTrigger=PropertyChanged}" Width="260"/>
        </StackPanel>
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,4">
            <TextBlock Text="Contraseña:" Width="90" VerticalAlignment="Center"/>
            <PasswordBox x:Name="PasswordBox" Width="260"/>
        </StackPanel>

        <StackPanel Grid.Row="6" VerticalAlignment="Bottom">
            <TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap" Foreground="DarkSlateGray" Margin="0,8"/>
        </StackPanel>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Probar conexión" Command="{Binding ProbarConexionCommand}" Padding="10,4" Margin="0,0,8,0"/>
            <Button Content="Continuar" Command="{Binding ContinuarCommand}" Padding="10,4" Margin="0,0,8,0"/>
            <Button Content="Cancelar" Command="{Binding CancelarCommand}" Padding="10,4"/>
        </StackPanel>
    </Grid>
</Window>
