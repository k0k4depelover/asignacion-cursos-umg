<UserControl x:Class="Asignacion.Wpf.Views.Estudiante.MisCalificacionesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Mis calificaciones" FontSize="18" FontWeight="Bold"/>
            <Button Content="Actualizar" Command="{Binding CargarCommand}" Padding="10,4" HorizontalAlignment="Right"/>
        </DockPanel>

        <TextBlock Grid.Row="1" Text="{Binding MensajeError}" Foreground="Red" Margin="0,0,0,8"/>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Calificaciones}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Período" Binding="{Binding PeriodoCodigo}"/>
                <DataGridTextColumn Header="Curso" Binding="{Binding CursoNombre}" Width="*"/>
                <DataGridTextColumn Header="Nota final" Binding="{Binding NotaFinal}"/>
                <DataGridTextColumn Header="Resultado" Binding="{Binding Resultado}"/>
                <DataGridTextColumn Header="Fecha" Binding="{Binding FechaResultado}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
