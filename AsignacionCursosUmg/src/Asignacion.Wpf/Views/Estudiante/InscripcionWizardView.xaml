<UserControl x:Class="Asignacion.Wpf.Views.Estudiante.InscripcionWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Asignacion.Wpf.Converters">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,0">
            <TextBlock Text="Inscripción" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

            <TextBlock Text="{Binding MensajeError}" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,12"/>

            <!-- Paso 1: período -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16" Visibility="{Binding MostrandoResultado, Converter={StaticResource InverseBoolToVis}}">
                <TextBlock Text="Período:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Width="200" ItemsSource="{Binding PeriodosDisponibles}" DisplayMemberPath="Codigo"
                          SelectedValuePath="Id" SelectedValue="{Binding IdPeriodoSeleccionado}" Margin="0,0,8,0"/>
                <Button Content="Buscar cursos disponibles" Command="{Binding BuscarCursosCommand}" Padding="10,4"/>
            </StackPanel>

            <!-- Paso 2: cursos y secciones -->
            <ItemsControl ItemsSource="{Binding CursosElegibles}"
                          Visibility="{Binding MostrandoFormularioCursos, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#FFD1D5DB" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <DockPanel>
                                    <CheckBox IsChecked="{Binding Seleccionado}" IsEnabled="{Binding Curso.CumpleRequisitos}"
                                              Content="{Binding Curso.Nombre}" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Curso.Creditos, StringFormat='{}{0} créditos'}" HorizontalAlignment="Right" Foreground="Gray"/>
                                </DockPanel>
                                <TextBlock Text="{Binding Curso.MotivoNoElegible}" Foreground="OrangeRed" Margin="24,2,0,0"
                                           Visibility="{Binding Curso.CumpleRequisitos, Converter={StaticResource InverseBoolToVis}}"/>
                                <StackPanel Orientation="Horizontal" Margin="24,6,0,0" Visibility="{Binding Curso.CumpleRequisitos, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Sección:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox Width="360" ItemsSource="{Binding Secciones}" SelectedValuePath="IdSeccion"
                                              SelectedValue="{Binding IdSeccionSeleccionada}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} — {1} — cupo {2}/{3}">
                                                            <Binding Path="Codigo"/>
                                                            <Binding Path="CatedraticoNombre"/>
                                                            <Binding Path="CupoOcupado"/>
                                                            <Binding Path="CupoMaximo"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="Confirmar inscripción" Command="{Binding ConfirmarInscripcionCommand}" Padding="12,6"
                    HorizontalAlignment="Left" Margin="0,8,0,0"
                    Visibility="{Binding MostrandoFormularioCursos, Converter={StaticResource BoolToVis}}"/>

            <!-- Paso 3: resultado -->
            <Border Background="#FFEFFDF3" CornerRadius="6" Padding="20" Margin="0,16,0,0"
                    Visibility="{Binding MostrandoResultado, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="¡Inscripción registrada!" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding Resultado.SeccionesInscritas, StringFormat='Secciones: {0}'}" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding Resultado.CostoInscripcion, StringFormat='Costo de inscripción: Q {0:N2}'}"/>
                    <TextBlock Text="{Binding Resultado.MontoMensual, StringFormat='Monto mensual: Q {0:N2}'}"/>
                    <TextBlock Text="{Binding Resultado.SubtotalLaboratorios, StringFormat='Subtotal laboratorios: Q {0:N2}'}"/>
                    <TextBlock Text="{Binding Resultado.TotalPago, StringFormat='Total mensual: Q {0:N2}'}" FontWeight="Bold" Margin="0,6,0,12"/>
                    <Button Content="Realizar otra inscripción" Command="{Binding NuevaInscripcionCommand}" Padding="10,4" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
