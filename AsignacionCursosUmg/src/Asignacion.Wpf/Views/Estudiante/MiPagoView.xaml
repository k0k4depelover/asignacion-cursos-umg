<UserControl x:Class="Asignacion.Wpf.Views.Estudiante.MiPagoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <DockPanel Margin="0,0,0,16">
            <TextBlock Text="Mi pago" FontSize="18" FontWeight="Bold"/>
            <Button Content="Actualizar" Command="{Binding CargarCommand}" Padding="10,4" HorizontalAlignment="Right"/>
        </DockPanel>

        <TextBlock Text="{Binding MensajeError}" Foreground="Red" Margin="0,0,0,12"/>

        <Border Background="#FFF1F5F9" CornerRadius="6" Padding="20" Width="360" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="Solvencia:" FontWeight="Bold"/>
                <TextBlock Text="{Binding Inscripcion.EstadoSolvencia}" Margin="0,0,0,10"/>

                <TextBlock Text="Costo de inscripción:" FontWeight="Bold"/>
                <TextBlock Text="{Binding Inscripcion.CostoInscripcion, StringFormat='Q {0:N2}'}" Margin="0,0,0,10"/>

                <TextBlock Text="Monto mensual (colegiatura):" FontWeight="Bold"/>
                <TextBlock Text="{Binding Inscripcion.MontoMensual, StringFormat='Q {0:N2}'}" Margin="0,0,0,10"/>

                <TextBlock Text="Subtotal laboratorios:" FontWeight="Bold"/>
                <TextBlock Text="{Binding Asignacion.SubtotalLaboratorios, StringFormat='Q {0:N2}'}" Margin="0,0,0,10"/>

                <TextBlock Text="Total mensual a pagar:" FontWeight="Bold"/>
                <TextBlock Text="{Binding Asignacion.TotalPago, StringFormat='Q {0:N2}'}" FontSize="18"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
