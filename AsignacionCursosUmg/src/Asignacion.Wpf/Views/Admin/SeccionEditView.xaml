<UserControl x:Class="Asignacion.Wpf.Views.Admin.SeccionEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="420">
    <StackPanel Margin="16">
        <TextBlock Text="{Binding TituloDialogo}" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>

        <TextBlock Text="Código:"/>
        <TextBox Text="{Binding Codigo, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>

        <TextBlock Text="Jornada:"/>
        <TextBox Text="{Binding Jornada, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>

        <TextBlock Text="Cupo máximo:"/>
        <TextBox Text="{Binding CupoMaximo, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>

        <TextBlock Text="Curso:"/>
        <ComboBox ItemsSource="{Binding Cursos}" DisplayMemberPath="Nombre" SelectedValuePath="Id" SelectedValue="{Binding IdCurso}" Margin="0,2,0,10"/>

        <TextBlock Text="Período académico:"/>
        <ComboBox ItemsSource="{Binding Periodos}" DisplayMemberPath="Codigo" SelectedValuePath="Id" SelectedValue="{Binding IdPeriodo}" Margin="0,2,0,10"/>

        <TextBlock Text="Catedrático:"/>
        <ComboBox ItemsSource="{Binding Catedraticos}" DisplayMemberPath="NombreCompleto" SelectedValuePath="Id" SelectedValue="{Binding IdCatedratico}" Margin="0,2,0,10"/>

        <TextBlock Text="Salón:"/>
        <ComboBox ItemsSource="{Binding Salones}" DisplayMemberPath="Nombre" SelectedValuePath="Id" SelectedValue="{Binding IdSalon}" Margin="0,2,0,10"/>

        <CheckBox Content="Activo" IsChecked="{Binding Activo}" Margin="0,0,0,10"/>

        <TextBlock Text="{Binding MensajeError}" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,8"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Guardar" Command="{Binding GuardarCommand}" Padding="10,4" Margin="0,0,8,0"/>
            <Button Content="Cancelar" Command="{Binding CancelarCommand}" Padding="10,4"/>
        </StackPanel>
    </StackPanel>
</UserControl>
