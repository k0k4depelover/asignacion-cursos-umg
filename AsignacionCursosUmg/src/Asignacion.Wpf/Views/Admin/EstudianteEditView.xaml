<UserControl x:Class="Asignacion.Wpf.Views.Admin.EstudianteEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="420">
    <StackPanel Margin="16">
        <TextBlock Text="{Binding TituloDialogo}" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>

        <TextBlock Text="Carnet:"/>
        <TextBox Text="{Binding Carnet, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>

        <TextBlock Text="DPI:"/>
        <TextBox Text="{Binding Dpi, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>

        <TextBlock Text="Nombres:"/>
        <TextBox Text="{Binding Nombres, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>

        <TextBlock Text="Apellidos:"/>
        <TextBox Text="{Binding Apellidos, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>

        <TextBlock Text="Fecha de nacimiento:"/>
        <DatePicker SelectedDate="{Binding FechaNacimiento}" Margin="0,2,0,10"/>

        <TextBlock Text="Dirección:"/>
        <TextBox Text="{Binding Direccion, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>

        <TextBlock Text="Teléfono:"/>
        <TextBox Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>

        <TextBlock Text="Ciclo actual:"/>
        <TextBox Text="{Binding CicloActual, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>

        <TextBlock Text="Usuario:"/>
        <ComboBox ItemsSource="{Binding Usuarios}" DisplayMemberPath="CorreoLogin" SelectedValuePath="Id"
                  SelectedValue="{Binding IdUsuario}" Margin="0,2,0,10"/>

        <TextBlock Text="Pensum:"/>
        <ComboBox ItemsSource="{Binding Pensums}" DisplayMemberPath="Codigo" SelectedValuePath="Id"
                  SelectedValue="{Binding IdPensum}" Margin="0,2,0,10"/>

        <CheckBox Content="Activo" IsChecked="{Binding Activo}" Margin="0,0,0,10"/>

        <TextBlock Text="{Binding MensajeError}" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,8"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Guardar" Command="{Binding GuardarCommand}" Padding="10,4" Margin="0,0,8,0"/>
            <Button Content="Cancelar" Command="{Binding CancelarCommand}" Padding="10,4"/>
        </StackPanel>
    </StackPanel>
</UserControl>
