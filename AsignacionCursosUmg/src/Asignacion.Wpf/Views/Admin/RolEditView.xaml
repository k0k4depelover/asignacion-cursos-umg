<UserControl x:Class="Asignacion.Wpf.Views.Admin.RolEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="360">
    <StackPanel Margin="16">
        <TextBlock Text="{Binding TituloDialogo}" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>

        <TextBlock Text="Nombre:"/>
        <TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>

        <TextBlock Text="Descripción:"/>
        <TextBox Text="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>

        <CheckBox Content="Activo" IsChecked="{Binding Activo}" Margin="0,0,0,10"/>

        <TextBlock Text="{Binding MensajeError}" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,8"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Guardar" Command="{Binding GuardarCommand}" Padding="10,4" Margin="0,0,8,0"/>
            <Button Content="Cancelar" Command="{Binding CancelarCommand}" Padding="10,4"/>
        </StackPanel>
    </StackPanel>
</UserControl>
