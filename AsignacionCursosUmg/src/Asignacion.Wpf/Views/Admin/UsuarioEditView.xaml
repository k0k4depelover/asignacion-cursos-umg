<UserControl x:Class="Asignacion.Wpf.Views.Admin.UsuarioEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="380">
    <StackPanel Margin="16">
        <TextBlock Text="{Binding TituloDialogo}" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>

        <TextBlock Text="Nombre de usuario:"/>
        <TextBox Text="{Binding NombreUsuario, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>

        <TextBlock Text="Correo de acceso:"/>
        <TextBox Text="{Binding CorreoLogin, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>

        <TextBlock Text="Correo de recuperación:"/>
        <TextBox Text="{Binding CorreoRecuperacion, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>

        <TextBlock Text="Rol:"/>
        <ComboBox ItemsSource="{Binding Roles}" DisplayMemberPath="Nombre" SelectedValuePath="Id"
                  SelectedValue="{Binding IdRol}" Margin="0,2,0,10"/>

        <TextBlock Text="Contraseña inicial (solo al crear):"/>
        <PasswordBox x:Name="PasswordBoxControl" PasswordChanged="PasswordBoxControl_OnPasswordChanged" Margin="0,2,0,10"/>

        <CheckBox Content="Activo" IsChecked="{Binding Activo}" Margin="0,0,0,10"/>

        <Button Content="Generar contraseña temporal" Command="{Binding ResetearPasswordCommand}"
                HorizontalAlignment="Left" Padding="10,4" Margin="0,0,0,10"/>

        <TextBlock Text="{Binding PasswordTemporalGenerada}"
                   TextWrapping="Wrap" FontWeight="Bold" Foreground="DarkGreen" Margin="0,0,0,10"/>

        <TextBlock Text="{Binding MensajeError}" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,8"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Guardar" Command="{Binding GuardarCommand}" Padding="10,4" Margin="0,0,8,0"/>
            <Button Content="Cancelar" Command="{Binding CancelarCommand}" Padding="10,4"/>
        </StackPanel>
    </StackPanel>
</UserControl>
